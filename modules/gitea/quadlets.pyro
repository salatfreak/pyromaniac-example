(name: str, domain: str)

containers.gitea:
  enabled: true
  image: docker.io/gitea/gitea:latest-rootless
  user_n_s: keep-id:uid=1000,gid=1000

  environment: {% run _.environment %}
    # reverse proxy socket
    server.protocol: http+unix
    server.http_addr: /run/channels/proxy/socket
    server.unix_socket_permission: 660

    # public server URL and SSH port
    server.domain: `domain`
    server.ssh_domain: `domain`
    server.root_url: `"https://%s/" % domain`
    server.ssh_port: 22

    # disable publicly accessible install page
    security.install_lock: true

    # disable open self-registration
    service.disable_registration: true
  {% endrun %}

  secret:
    # initial admin credentials used by gitea-create-admin.service
    - gitea-admin-name,uid=1000,mode=400
    - gitea-admin-pass,uid=1000,mode=400

  volume:
    # custom entrypoint script
    - "%h/custom-entrypoint.sh:/custom-entrypoint.sh:ro,Z"

    # reverse proxy socket directory
    - `"/run/channels/{}:/run/channels/proxy:z".format(name)`

    # persist application data and secrets generated by custom entrypoint
    - data:/var/lib/gitea

  # start custom entrypoint
  entrypoint: '["/usr/bin/dumb-init", "--", "/bin/bash", "/custom-entrypoint.sh"]'
  publish_port: 10022:2222

  # unit dependencies
  unit:
    wants: gitea-create-admin.service
    before: gitea-create-admin.service

    # always restart container when it exits
  service.restart: always
